{
  "name": "jehlp-homepage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:search": "node tools/build-search.mjs",
    "build:site": "node build.mjs && node tools/build-search.mjs",
    "test": "node --test tests/*.test.mjs",
    "refresh:search": "node build.mjs && node tools/build-search.mjs && node tools/publish-search.mjs",
    "pretest": "node build.mjs"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "jsdom": "30.1.1",
    "pagefind": "1.5.2",
    "parse5": "8.0.1"
  }
}
